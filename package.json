{
  "name": "nexo-inventario",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p backend/tsconfig.json --noEmit && tsc -p frontend/tsconfig.json --noEmit",
    "build": "tsc -p backend/tsconfig.json && tsc -p frontend/tsconfig.json && node tools/copy-static.mjs",
    "start": "node dist/backend/src/server.js",
    "dev": "npm run build && npm start",
    "test": "npm run build && node --test dist/backend/tests/*.test.js"
  },
  "dependencies": {
    "mysql2": "3.24.6"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
