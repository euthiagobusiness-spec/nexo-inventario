# Plantilla sin credenciales. Copiar a .env y completar solo localmente.
# Node lee este archivo si INVENTARIO_ENV_FILE apunta a su ruta.
HOST=127.0.0.1
PORT=5080
MYSQL_HOST=10.77.55.4
MYSQL_PORT=3306
MYSQL_DATABASE=inventario_db
MYSQL_USER=inventario_app
MYSQL_PASSWORD=
# Ruta absoluta a la CA del servidor MySQL, fuera del repositorio.
MYSQL_SSL_CA=
